values:
  - values/common.yaml

environments:
  default:
    values:
      - values/default.yaml
  production:
    values:
      - values/production.yaml

---
repositories:
  - name: bitnami
    url: https://charts.bitnami.com/bitnami

releases:
  - name: {{ .Values.app.name }}
    namespace: {{ .Environment.Name }}
    chart: bitnami/nginx
    version: {{ .Values.chartVersion | quote }}
    values:
      - values/app.yaml.gotmpl
