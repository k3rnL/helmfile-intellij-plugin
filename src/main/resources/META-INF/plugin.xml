<idea-plugin>
    <id>dev.helmfile.editor</id>
    <name>Helmfile</name>
    <vendor>Helmfile Plugin Contributors</vendor>
    <description><![CDATA[
      Helmfile YAML and Go template editing: contextual completion, state values navigation,
      environment selection, bidirectional values navigation, Find Usages, template inheritance
      gutter navigation, and configurable colors and documentation for Go, Sprig, and Helmfile functions.
      Run template, apply, delete, and destroy for individual releases with environment protection.
      Complete repository aliases, chart names, and versions, with repository validation and navigation.
      Browse downloaded chart sources as read-only folders under External Libraries.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable parentId="tools" id="dev.helmfile.settings" displayName="Helmfile"
                             instance="dev.helmfile.intellij.HelmfileConfigurable"/>
        <configurationType implementation="dev.helmfile.intellij.HelmfileRunConfigurationType"/>
        <additionalLibraryRootsProvider implementation="dev.helmfile.intellij.HelmfileChartLibraryProvider"/>
        <notificationGroup id="Helmfile repositories" displayType="BALLOON"/>
        <runLineMarkerContributor language="yaml" implementationClass="dev.helmfile.intellij.HelmfileReleaseLineMarkerContributor"/>
        <fileType name="Helmfile Template" language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileFileType"
                  fieldName="INSTANCE" fileNames="helmfile.yaml;helmfile.yml" extensions="gotmpl" patterns="_*.tpl"/>
        <lang.parserDefinition language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileParserDefinition"/>
        <lang.fileViewProviderFactory language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileViewProviderFactory"/>
        <lang.syntaxHighlighterFactory language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="dev.helmfile.intellij.HelmfileColorSettingsPage"/>
        <completion.contributor language="any" implementationClass="dev.helmfile.intellij.HelmfileCompletionContributor"/>
        <completion.confidence language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileCompletionConfidence"/>
        <lang.documentationProvider language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileDocumentationProvider"/>
        <lang.documentationProvider language="yaml" implementationClass="dev.helmfile.intellij.HelmfileDocumentationProvider"/>
        <psi.referenceContributor language="yaml" implementation="dev.helmfile.intellij.HelmfileReferenceContributor"/>
        <lang.findUsagesProvider language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileFindUsagesProvider"/>
        <findUsagesHandlerFactory implementation="dev.helmfile.intellij.HelmfileFindUsagesHandlerFactory" order="first"/>
        <gotoDeclarationHandler implementation="dev.helmfile.intellij.HelmfileGotoDeclarationHandler" order="first"/>
        <codeInsight.lineMarkerProvider language="yaml" implementationClass="dev.helmfile.intellij.HelmfileInheritanceLineMarkerProvider"/>
        <annotator language="Helmfile" implementationClass="dev.helmfile.intellij.HelmfileAnnotator"/>
        <localInspection language="yaml" shortName="HelmfileRepositories" displayName="Helmfile chart repositories"
                         groupName="Helmfile" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.helmfile.intellij.HelmfileRepositoryInspection"/>
        <intentionAction>
            <className>dev.helmfile.intellij.FunctionDocumentationIntention</className>
            <category>Helmfile</category>
        </intentionAction>
    </extensions>
    <actions>
        <group id="Helmfile.ReleaseActions" text="Helmfile" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="Helmfile.Release.Template" class="dev.helmfile.intellij.HelmfileReleaseAction$Template" text="Template Release…"/>
            <action id="Helmfile.Release.Apply" class="dev.helmfile.intellij.HelmfileReleaseAction$Apply" text="Apply Release…"/>
            <action id="Helmfile.Release.Delete" class="dev.helmfile.intellij.HelmfileReleaseAction$Delete" text="Delete Release…"/>
            <action id="Helmfile.Release.Destroy" class="dev.helmfile.intellij.HelmfileReleaseAction$Destroy" text="Destroy Release…"/>
        </group>
        <action id="Helmfile.SelectEnvironment" class="dev.helmfile.intellij.SelectEnvironmentAction"
                text="Helmfile: Select Environment" description="Select the Helmfile environment used for values completion and navigation">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Helmfile.RefreshRepositories" class="dev.helmfile.intellij.RefreshRepositoriesAction"
                text="Helmfile: Refresh Chart Repositories" description="Refresh chart names and versions from the current Helmfile's repositories">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
